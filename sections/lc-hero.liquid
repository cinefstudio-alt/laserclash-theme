{%- comment -%} LC Starter — Hero + Bundle selector (self-contained, reusable) {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700;800;900&family=DM+Sans:wght@400;500;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">

{%- assign p = product -%}
{%- if p == blank -%}{%- assign p = all_products[section.settings.product] -%}{%- endif -%}

{%- if p == blank and request.design_mode -%}
  <div style="padding:20px;text-align:center;font-family:sans-serif;background:#FFF4D6;color:#6B4E00;border:1px dashed #C9A227;border-radius:12px;margin:16px">
    <strong>Pick a product</strong> — open this section's settings and choose the product it should sell.
  </div>
{%- endif -%}


<style>
#lc-hero-{{ section.id }}{
  --lc-bg: {{ section.settings.bg }};
  --lc-ink: {{ section.settings.ink }};
  --lc-blue: {{ section.settings.blue }};
  --lc-accent: {{ section.settings.accent }};
  --lc-accent-ink: {{ section.settings.accent_ink }};
  --lc-card: {{ section.settings.card }};
  --lc-line: {{ section.settings.line }};
  --lc-muted: {{ section.settings.muted }};
  --lc-radius: {{ section.settings.radius }}px;
}
#lc-hero-{{ section.id }} *{box-sizing:border-box}
#lc-hero-{{ section.id }}{background:var(--lc-bg);color:var(--lc-ink);font-family:'DM Sans',-apple-system,Arial,sans-serif;padding:28px 16px 40px}
#lc-hero-{{ section.id }} .lc-wrap{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
/* grid sutunu 1fr = minmax(auto,1fr) demekdir: icindeki en enli element (minatur lenti) sutunu sisirdirdi, mobilde ise kenar kesilirdi */
#lc-hero-{{ section.id }} .lc-wrap > *{min-width:0}
#lc-hero-{{ section.id }} h1,#lc-hero-{{ section.id }} h2,#lc-hero-{{ section.id }} h3{font-family:'Barlow',sans-serif;text-transform:uppercase;line-height:.98;margin:0;letter-spacing:-.01em}
/* gallery */
#lc-hero-{{ section.id }} .lc-gal{position:sticky;top:16px}
#lc-hero-{{ section.id }} .lc-main{position:relative;border-radius:var(--lc-radius);overflow:hidden;background:#05070f;aspect-ratio:1/1}
#lc-hero-{{ section.id }} .lc-main img{width:100%;height:100%;object-fit:cover;display:none}
#lc-hero-{{ section.id }} .lc-main img.on{display:block}
#lc-hero-{{ section.id }} .lc-thumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;padding-bottom:4px;justify-content:safe center;scrollbar-width:none}
#lc-hero-{{ section.id }} .lc-thumbs::-webkit-scrollbar{display:none}
#lc-hero-{{ section.id }} .lc-main{touch-action:pan-y;cursor:grab}
#lc-hero-{{ section.id }} .lc-main.is-drag{cursor:grabbing}
#lc-hero-{{ section.id }} .lc-thumbs button{flex:0 0 auto;width:64px;height:64px;border-radius:12px;overflow:hidden;border:2px solid var(--lc-line);background:#05070f;cursor:pointer;padding:0}
#lc-hero-{{ section.id }} .lc-thumbs button.on{border-color:var(--lc-blue)}
#lc-hero-{{ section.id }} .lc-thumbs img{width:100%;height:100%;object-fit:cover}
/* info */
#lc-hero-{{ section.id }} .lc-eyebrow{font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:13px;color:var(--lc-blue)}
#lc-hero-{{ section.id }} h1{font-size:clamp(34px,4.4vw,56px);font-weight:900;color:var(--lc-blue);margin:10px 0 0}
/* --- reyting setri: ulduzlar + say --- */
#lc-hero-{{ section.id }} .lc-rating{
  display:flex;
  align-items:center;
  gap:10px;
  margin:0 0 10px;
}

#lc-hero-{{ section.id }} .lc-rating__stars{
  position:relative;
  display:inline-block;
  font-size:17px;
  line-height:1;
  letter-spacing:2px;
  white-space:nowrap;
}

#lc-hero-{{ section.id }} .lc-rating__base{ color:#D7DEEA; }

#lc-hero-{{ section.id }} .lc-rating__fill{
  position:absolute;
  inset:0;
  width:var(--lc-stars, 100%);
  overflow:hidden;
  color:#FFC107;
}

#lc-hero-{{ section.id }} .lc-rating__text{
  font-family:'Montserrat',-apple-system,sans-serif;
  font-size:14px;
  font-weight:700;
  color:var(--lc-ink);
}

#lc-hero-{{ section.id }} .lc-sub{color:var(--lc-muted);font-size:17px;line-height:1.5;margin:14px 0 0;max-width:46ch}
#lc-hero-{{ section.id }} .lc-pills{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 0}
#lc-hero-{{ section.id }} .lc-pill{background:var(--lc-card);color:var(--lc-ink);font-weight:700;font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:8px 12px;border-radius:999px}
/* bundle */
#lc-hero-{{ section.id }} .lc-choose{display:flex;justify-content:space-between;align-items:baseline;margin:26px 0 12px;gap:12px}
#lc-hero-{{ section.id }} .lc-choose h3{font-size:22px;font-weight:800}
#lc-hero-{{ section.id }} .lc-choose span{color:var(--lc-muted);font-size:13px;text-align:right}
#lc-hero-{{ section.id }} .lc-opts{display:flex;flex-direction:column;gap:12px}
#lc-hero-{{ section.id }} .lc-opt{position:relative;display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:14px;align-items:center;border:2px solid var(--lc-line);border-radius:14px;padding:16px 18px;cursor:pointer;background:#fff;transition:border-color .15s,box-shadow .15s}
#lc-hero-{{ section.id }} .lc-opt:hover{border-color:var(--lc-blue)}
#lc-hero-{{ section.id }} .lc-opt.on{border-color:var(--lc-blue);box-shadow:0 0 0 3px rgba(23,66,162,.12)}
#lc-hero-{{ section.id }} .lc-radio{width:20px;height:20px;border-radius:50%;border:2px solid var(--lc-line);position:relative}
#lc-hero-{{ section.id }} .lc-opt.on .lc-radio{border-color:var(--lc-blue)}
#lc-hero-{{ section.id }} .lc-opt.on .lc-radio:after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--lc-blue)}
#lc-hero-{{ section.id }} .lc-opt .lc-t{font-family:'Barlow',sans-serif;text-transform:uppercase;font-weight:800;font-size:18px;display:flex;align-items:center;gap:8px}
#lc-hero-{{ section.id }} .lc-opt .lc-d{color:var(--lc-muted);font-size:13px;margin-top:4px;display:block}
#lc-hero-{{ section.id }} .lc-save{color:#128a3a;font-size:12px;font-weight:700;margin-top:4px;display:block}
#lc-hero-{{ section.id }} .lc-tag{background:var(--lc-accent);color:var(--lc-accent-ink);font-weight:800;font-size:11px;letter-spacing:.04em;padding:3px 8px;border-radius:999px}
#lc-hero-{{ section.id }} .lc-price{text-align:right}
#lc-hero-{{ section.id }} .lc-price .cmp{color:var(--lc-muted);text-decoration:line-through;font-size:13px;display:block}
#lc-hero-{{ section.id }} .lc-price .now{font-family:'Barlow',sans-serif;font-weight:800;font-size:22px;display:block}
#lc-hero-{{ section.id }} .lc-price .per{color:var(--lc-muted);font-size:12px;display:block}
/* "Most popular" lenti: mavi hab, neon kenar ve yungul hale - gozu ilk ora cekir */
#lc-hero-{{ section.id }} .lc-popular{
  position:absolute;
  top:-14px;
  right:16px;
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 14px 6px 12px;
  border-radius:999px;
  background:var(--lc-blue);
  border:2px solid var(--lc-accent);
  color:#fff;
  font-family:'Barlow',sans-serif;
  font-weight:600;
  font-size:11.5px;
  letter-spacing:.09em;
  white-space:nowrap;
  transform:rotate(-4deg);
  transform-origin:center;
  box-shadow:0 4px 14px rgba(23,66,162,.35), 0 0 0 4px rgba(191,255,15,.14);
}

#lc-hero-{{ section.id }} .lc-popular::before{
  content:"\2726";
  font-size:12px;
  line-height:1;
  color:#fff;
  /* ulduz bir az isildasin - lentin solunda kicik vurgu */
  text-shadow:0 0 6px rgba(191,255,15,.95), 0 0 12px rgba(191,255,15,.55);
}

#lc-hero-{{ section.id }} .lc-opt.on .lc-popular{
  box-shadow:0 6px 18px rgba(23,66,162,.45), 0 0 0 5px rgba(191,255,15,.2);
}
/* colors */
#lc-hero-{{ section.id }} .lc-colors{display:flex;gap:10px;margin:20px 0 0;flex-wrap:wrap}
#lc-hero-{{ section.id }} .lc-colors button{border:2px solid var(--lc-line);background:var(--lc-card);border-radius:10px;padding:9px 14px;font-weight:700;font-size:13px;cursor:pointer;color:var(--lc-ink)}
#lc-hero-{{ section.id }} .lc-colors button.on{border-color:var(--lc-blue);background:#fff}
#lc-hero-{{ section.id }} .lc-clabel{font-weight:700;font-size:13px;margin:20px 0 8px;text-transform:uppercase;letter-spacing:.06em}
/* cta */
#lc-hero-{{ section.id }} .lc-cta{display:block;width:100%;margin-top:18px;background:var(--lc-accent);color:var(--lc-accent-ink);border:none;border-radius:12px;padding:18px;font-family:'Barlow',sans-serif;text-transform:uppercase;font-weight:900;font-size:19px;letter-spacing:.02em;cursor:pointer;transition:transform .1s,filter .15s}
#lc-hero-{{ section.id }} .lc-cta:hover{filter:brightness(1.05)}
#lc-hero-{{ section.id }} .lc-cta:active{transform:translateY(1px)}
/* included + trust */
#lc-hero-{{ section.id }} .lc-inc{margin-top:18px;background:var(--lc-card);border-radius:14px;padding:16px 18px}
#lc-hero-{{ section.id }} .lc-inc .hd{font-weight:800;text-transform:uppercase;letter-spacing:.06em;font-size:12px;color:var(--lc-blue);display:flex;align-items:center;gap:8px}
#lc-hero-{{ section.id }} .lc-inc ul{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}
#lc-hero-{{ section.id }} .lc-inc li{display:flex;gap:10px;font-size:14px;align-items:flex-start}
#lc-hero-{{ section.id }} .lc-inc li svg{flex:0 0 auto;margin-top:2px}
#lc-hero-{{ section.id }} .lc-trust{display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;justify-content:center}
#lc-hero-{{ section.id }} .lc-trust div{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--lc-muted)}
@media(max-width:860px){
  #lc-hero-{{ section.id }}{overflow-x:clip}
  #lc-hero-{{ section.id }} .lc-wrap{grid-template-columns:1fr;gap:24px}
  #lc-hero-{{ section.id }} .lc-gal{position:static}
}
@media(max-width:520px){
  #lc-hero-{{ section.id }} .lc-opt{grid-template-columns:22px 1fr;row-gap:4px;padding:14px 16px}
  #lc-hero-{{ section.id }} .lc-price{grid-column:2;text-align:left;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
  #lc-hero-{{ section.id }} .lc-price .now{font-size:20px}
  #lc-hero-{{ section.id }} .lc-choose{flex-wrap:wrap;gap:4px}
  #lc-hero-{{ section.id }} .lc-choose span{text-align:left}
  #lc-hero-{{ section.id }} .lc-popular{right:12px;top:-13px;font-size:10.5px;padding:5px 12px 5px 10px}
}
</style>

<section id="lc-hero-{{ section.id }}">
  <div class="lc-wrap">
    <!-- GALLERY -->
    <div class="lc-gal">
      <div class="lc-main" id="lc-main-{{ section.id }}">
        {%- if p and p.media.size > 0 -%}
          {%- for m in p.media -%}
            <img src="{{ m.preview_image | image_url: width: 1000 }}" alt="{{ m.preview_image.alt | escape }}" class="{% if forloop.first %}on{% endif %}" data-i="{{ forloop.index0 }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {%- endfor -%}
        {%- else -%}
          <img src="{{ 'product-1' | placeholder_svg_tag }}" class="on">
        {%- endif -%}
      </div>
      {%- if p and p.media.size > 1 -%}
      <div class="lc-thumbs" id="lc-thumbs-{{ section.id }}">
        {%- for m in p.media -%}
          <button class="{% if forloop.first %}on{% endif %}" data-i="{{ forloop.index0 }}"><img src="{{ m.preview_image | image_url: width: 160 }}" alt=""></button>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>

    <!-- INFO -->
    <div class="lc-info" id="lc-buy">
      {%- if section.settings.eyebrow != blank -%}<div class="lc-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.show_rating -%}
        {%- assign lc_stars = section.settings.rating_value | default: 5.0 -%}
        {%- assign lc_pct = lc_stars | times: 20.0 -%}
        <div class="lc-rating" role="img" aria-label="{{ lc_stars }} out of 5 stars{% if section.settings.rating_text != blank %}, {{ section.settings.rating_text | escape }}{% endif %}">
          <span class="lc-rating__stars" style="--lc-stars: {{ lc_pct }}%;" aria-hidden="true">
            <span class="lc-rating__base">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="lc-rating__fill">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          </span>
          {%- if section.settings.rating_text != blank -%}
            <span class="lc-rating__text">{{ section.settings.rating_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <h1>{{ section.settings.title | default: p.title }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="lc-sub">{{ section.settings.subtitle }}</p>{%- endif -%}

      {%- assign badges = section.blocks | where: "type", "badge" -%}
      {%- if badges.size > 0 -%}
      <div class="lc-pills">
        {%- for b in badges -%}<span class="lc-pill" {{ b.shopify_attributes }}>{{ b.settings.text }}</span>{%- endfor -%}
      </div>
      {%- endif -%}

      <!-- color variant -->
      {%- assign show_colors = false -%}
      {%- if p and p.variants.size > 1 -%}{%- assign show_colors = true -%}{%- endif -%}
      {%- assign vm_check = section.blocks | where: "type", "bundle" -%}
      {%- for b in vm_check -%}
        {%- if b.settings.variant != blank -%}{%- assign show_colors = false -%}{%- endif -%}
      {%- endfor -%}
      {%- if show_colors -%}
      <div class="lc-clabel">{{ section.settings.color_label }}</div>
      <div class="lc-colors" id="lc-colors-{{ section.id }}">
        {%- for v in p.variants -%}
          <button type="button" data-vid="{{ v.id }}" data-price="{{ v.price }}" class="{% if forloop.first %}on{% endif %}">{{ v.title }}</button>
        {%- endfor -%}
      </div>
      {%- endif -%}

      <!-- bundle -->
      {%- assign bundles = section.blocks | where: "type", "bundle" -%}
      {%- comment -%} Bir bundle blokuna variant baglanibsa, secim variantlar uzre gedir: qiymet carpilmir, variantin oz qiymeti gosterilir {%- endcomment -%}
      {%- assign variant_mode = false -%}
      {%- for b in bundles -%}
        {%- if b.settings.variant != blank -%}{%- assign variant_mode = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if bundles.size > 0 -%}
      <div class="lc-choose">
        <h3>{{ section.settings.bundle_heading }}</h3>
        <span>{{ section.settings.bundle_note }}</span>
      </div>
      <div class="lc-opts" id="lc-opts-{{ section.id }}">
        {%- for b in bundles -%}
          {%- assign bvid = '' -%}{%- assign bvprice = 0 -%}{%- assign bvcmp = 0 -%}
          {%- if b.settings.variant != blank and p -%}
            {%- for v in p.variants -%}
              {%- if v.title == b.settings.variant -%}
                {%- assign bvid = v.id -%}{%- assign bvprice = v.price -%}{%- assign bvcmp = v.compare_at_price | default: 0 -%}
                {%- capture bvmoney -%}{{ v.price | money }}{%- endcapture -%}
                {%- capture bvcmpmoney -%}{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}{%- endcapture -%}
                {%- capture bvsavemoney -%}{% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | money }}{% endif %}{%- endcapture -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <label class="lc-opt {% if b.settings.preselected %}on{% endif %}" data-units="{{ b.settings.units }}" data-disc="{{ b.settings.discount }}"{% if bvid != '' %} data-vid="{{ bvid }}" data-vprice="{{ bvprice }}" data-vcmp="{{ bvcmp }}" data-vmoney="{{ bvmoney | strip | escape }}" data-vcmpmoney="{{ bvcmpmoney | strip | escape }}" data-vsave="{{ bvsavemoney | strip | escape }}"{% endif %} {{ b.shopify_attributes }}>
            {%- if b.settings.popular -%}<span class="lc-popular">{{ b.settings.popular_text }}</span>{%- endif -%}
            <span class="lc-radio"></span>
            <span>
              <span class="lc-t">{{ b.settings.label }}{% if b.settings.tag != blank %}<span class="lc-tag">{{ b.settings.tag }}</span>{% endif %}</span>
              {%- if b.settings.desc != blank -%}<span class="lc-d">{{ b.settings.desc }}</span>{%- endif -%}
              <span class="lc-save" data-save></span>
            </span>
            <span class="lc-price">
              <span class="cmp" data-cmp></span>
              <span class="now" data-now></span>
              <span class="per" data-per></span>
            </span>
          </label>
        {%- endfor -%}
      </div>
      {%- endif -%}

      <!-- add to cart -->
      <form method="post" action="/cart/add" id="lc-form-{{ section.id }}">
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id | default: p.variants.first.id }}" id="lc-vid-{{ section.id }}">
        <input type="hidden" name="quantity" value="1" id="lc-qty-{{ section.id }}">
        <button type="submit" class="lc-cta" id="lc-cta-{{ section.id }}">{{ section.settings.cta_text }} <span data-ctaprice></span></button>
      </form>

      <!-- included -->
      {%- assign incs = section.blocks | where: "type", "include" -%}
      {%- if incs.size > 0 -%}
      <div class="lc-inc">
        <div class="hd">{{ section.settings.included_heading }}</div>
        <ul>
          {%- for i in incs -%}
          <li {{ i.shopify_attributes }}><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="{{ section.settings.blue }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ i.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}

      <!-- trust -->
      <div class="lc-trust">
        {%- if section.settings.trust1 != blank -%}<div>🔒 {{ section.settings.trust1 }}</div>{%- endif -%}
        {%- if section.settings.trust2 != blank -%}<div>✈️ {{ section.settings.trust2 }}</div>{%- endif -%}
        {%- if section.settings.trust3 != blank -%}<div>↩️ {{ section.settings.trust3 }}</div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var S="{{ section.id }}";
  var root=document.getElementById("lc-hero-"+S);
  if(!root) return;
  var CUR="{{ cart.currency.iso_code | default: shop.currency }}";
  var LOC=(document.documentElement.lang||"en");
  var nf;
  try{ nf=new Intl.NumberFormat(LOC,{style:"currency",currency:CUR}); }catch(e){ nf=null; }
  function fmt(v){ try{ return nf?nf.format(v):("$"+v.toFixed(2)); }catch(e){ return "$"+v.toFixed(2);} }
  var curPrice={{ p.selected_or_first_available_variant.price | default: p.variants.first.price | default: 0 | divided_by: 100.0 }};
  var curVid="{{ p.selected_or_first_available_variant.id | default: p.variants.first.id }}";
  // gallery
  var main=document.getElementById("lc-main-"+S);
  var thumbs=document.getElementById("lc-thumbs-"+S);
  function showImg(i){ if(!main)return; main.querySelectorAll("img").forEach(function(im){im.classList.toggle("on",im.dataset.i==i);}); if(thumbs)thumbs.querySelectorAll("button").forEach(function(b){b.classList.toggle("on",b.dataset.i==i);}); }
  if(thumbs)thumbs.querySelectorAll("button").forEach(function(b){b.addEventListener("click",function(){showImg(b.dataset.i);});});

  /* --- esas sekli barmaqla/siçanla surusdurerek deyismek --- */
  if (main) {
    var imgs = main.querySelectorAll("img");
    var count = imgs.length;

    function currentIndex(){
      var on = main.querySelector("img.on");
      return on ? parseInt(on.dataset.i, 10) || 0 : 0;
    }
    function step(dir){
      if (count < 2) return;
      var i = (currentIndex() + dir + count) % count;
      showImg(String(i));
      /* secilmis miniatur gorunsun */
      if (thumbs) {
        var tb = thumbs.querySelector('button[data-i="' + i + '"]');
        if (tb && tb.scrollIntoView) tb.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
      }
    }

    var sx = 0, sy = 0, down = false, moved = false;
    main.addEventListener("pointerdown", function (e) {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      down = true; moved = false; sx = e.clientX; sy = e.clientY;
      main.classList.add("is-drag");
    });
    main.addEventListener("pointermove", function (e) {
      if (!down) return;
      if (Math.abs(e.clientX - sx) > 8) moved = true;
    });
    function finish(e){
      if (!down) return;
      down = false;
      main.classList.remove("is-drag");
      var dx = e.clientX - sx, dy = e.clientY - sy;
      /* suruşdurme ufuqi olmalidir, eks halda sehife scroll-u sayilir */
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
    }
    main.addEventListener("pointerup", finish);
    main.addEventListener("pointercancel", function(){ down = false; main.classList.remove("is-drag"); });
    main.addEventListener("pointerleave", function(e){ if (down) finish(e); });

    /* klaviatura ile de kecid */
    main.setAttribute("tabindex", "0");
    main.addEventListener("keydown", function (e) {
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      if (e.key === "ArrowLeft")  { e.preventDefault(); step(-1); }
    });
  }
  // bundle
  var opts=document.getElementById("lc-opts-"+S);
  function recalc(){
    if(opts)opts.querySelectorAll(".lc-opt").forEach(function(o){
      var cmp=o.querySelector("[data-cmp]"), nowE=o.querySelector("[data-now]"), perE=o.querySelector("[data-per]"), saveE=o.querySelector("[data-save]");
      /* Variant rejimi: qiymet variantin oz qiymetidir, hec ne carpilmir */
      if(o.dataset.vid){
        /* Magazanin oz pul formati (Liquid money filtri) - Intl ile uydurmaqdansa birbasa onu gosteririk */
        if(nowE)nowE.textContent=o.dataset.vmoney||"";
        if(cmp)cmp.textContent=o.dataset.vcmpmoney||"";
        if(saveE)saveE.textContent=o.dataset.vsave?("You save "+o.dataset.vsave):"";
        if(perE)perE.textContent="";
        return;
      }
      var u=parseInt(o.dataset.units)||1, d=parseFloat(o.dataset.disc)||0;
      var full=curPrice*u, now=full*(1-d/100);
      var per=now/u;
      if(nowE)nowE.textContent=fmt(now);
      if(d>0){ if(cmp)cmp.textContent=fmt(full); if(saveE)saveE.textContent="You save "+fmt(full-now); }
      else { if(cmp)cmp.textContent=""; if(saveE)saveE.textContent=""; }
      if(perE)perE.textContent=fmt(per)+" {{ section.settings.per_unit_suffix }}";
    });
    var sel=opts?opts.querySelector(".lc-opt.on"):null;
    var now, u=1;
    if(sel && sel.dataset.vid){
      now=parseFloat(sel.dataset.vprice)/100;
      curVid=sel.dataset.vid;
      var vi=document.getElementById("lc-vid-"+S); if(vi)vi.value=curVid;
      var cpv=root.querySelector("[data-ctaprice]"); if(cpv)cpv.textContent=sel.dataset.vmoney||"";
      var qv=document.getElementById("lc-qty-"+S); if(qv)qv.value=1;
      document.dispatchEvent(new CustomEvent("lc:update",{detail:{vid:curVid,units:1,price:now,money:sel.dataset.vmoney||""}}));
      return;
    } else {
      u=sel?(parseInt(sel.dataset.units)||1):1;
      var d=sel?(parseFloat(sel.dataset.disc)||0):0;
      now=curPrice*u*(1-d/100);
    }
    var cp=root.querySelector("[data-ctaprice]"); if(cp)cp.textContent=fmt(now);
    var qty=document.getElementById("lc-qty-"+S); if(qty)qty.value=u;
    document.dispatchEvent(new CustomEvent("lc:update",{detail:{vid:curVid,units:u,price:now}}));
  }
  if(opts)opts.querySelectorAll(".lc-opt").forEach(function(o){ o.addEventListener("click",function(){ opts.querySelectorAll(".lc-opt").forEach(function(x){x.classList.remove("on");}); o.classList.add("on"); recalc(); }); });
  var colors=document.getElementById("lc-colors-"+S);
  if(colors)colors.querySelectorAll("button").forEach(function(c){ c.addEventListener("click",function(){ colors.querySelectorAll("button").forEach(function(x){x.classList.remove("on");}); c.classList.add("on"); curVid=c.dataset.vid; curPrice=parseFloat(c.dataset.price)/100; var vi=document.getElementById("lc-vid-"+S); if(vi)vi.value=curVid; recalc(); }); });
  if(opts && !opts.querySelector(".lc-opt.on")){ var f=opts.querySelector(".lc-opt"); if(f)f.classList.add("on"); }
  recalc();
  /* Yapisqan panel bu bolmeden sonra yuklenir - ilk hadiseni qacirir.
     Ona gore sehife tam yuklenende bir de gonderilir. */
  window.addEventListener("load", recalc);
  setTimeout(recalc, 600);

  /* ---- Sebet: AJAX elave + sag terefden acilan panel (temanin oz drawer-i) ----
     Qlobal olaraq bir defe teyin olunur ki, hero ve yapisqan panel eyni kodu islesin. */
  if (!window.lcCartAdd) {
    window.lcCartAdd = function (variantId, quantity, button) {
      if (!variantId) return;
      var label = button ? button.textContent : '';
      if (button) { button.disabled = true; button.textContent = 'Adding...'; }

      return fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({
          items: [{ id: parseInt(variantId, 10), quantity: parseInt(quantity, 10) || 1 }],
          sections: ['cart-drawer-section']
        })
      })
        .then(function (r) { return r.json().then(function (d) { return r.ok ? d : Promise.reject(d); }); })
        .then(function (data) {
          /* panelin icini tezelemek ucun Shopify-in section rendering cavabi */
          var html = data.sections && data.sections['cart-drawer-section'];
          if (html) {
            var fresh = new DOMParser()
              .parseFromString(html, 'text/html')
              .querySelector('#shopify-section-cart-drawer-section');
            var current = document.getElementById('shopify-section-cart-drawer-section');
            if (fresh && current) current.replaceWith(fresh);
          }
          var drawer = document.getElementById('cart-drawer');
          if (drawer && typeof drawer.open === 'function') drawer.open();
          document.dispatchEvent(new CustomEvent('lc:added', { detail: { id: variantId } }));
        })
        .catch(function (err) {
          var msg = (err && err.description) || (err && err.message) || 'Could not add to cart';
          if (button) { button.textContent = msg.slice(0, 40); setTimeout(function () { button.textContent = label; }, 2500); }
        })
        .then(function () {
          if (button) { button.disabled = false; if (button.textContent === 'Adding...') button.textContent = label; }
        });
    };


  /* Panelden kenara klikleyende baglansin.
     Vacib: paneli acan klik hemin an senede de catir. Dinleyicini derhal
     qosaq, o klik "kenar klik" sayilir ve panel acilan kimi baglanir.
     Ona gore dinleyici yalniz acilma hadisesinden SONRAKI dovrede qosulur
     ve baglananda geri silinir. */
  if (!window.lcDrawerOutsideBound) {
    window.lcDrawerOutsideBound = true;

    /* Temanin oz baglama axinini isledirik: td.close() cagirmaq dialoq ile
       komponentin veziyyetini uzlasdirmir ve panel bir daha acilmir. */
    var lcShut = function () {
      var td = document.getElementById('cart-drawer');
      if (!td || !td.hasAttribute('open')) return;
      var closeBtn = td.querySelector('[data-drawer-close], button[aria-label="Close"], button[aria-label*="Close" i]');
      if (closeBtn) closeBtn.click();
      else if (typeof td.close === 'function') td.close();
    };

    var lcOutside = function (e) {
      var td = document.getElementById('cart-drawer');
      if (!td || !td.hasAttribute('open')) return;
      if (e.target && e.target.closest && e.target.closest('#cart-drawer')) return;
      lcShut();
    };

    var lcEsc = function (e) {
      if (e.key === 'Escape') lcShut();
    };

    document.addEventListener('theme-drawer:open', function (e) {
      var td = e.target && e.target.closest ? e.target.closest('theme-drawer') : null;
      if (td && td.id !== 'cart-drawer') return;
      /* Panel hansi yolla acilirsa acilsin - loqo ve zolaq hemise olsun */
      setTimeout(function () {
        document.addEventListener('click', lcOutside);
        document.addEventListener('keydown', lcEsc);
      }, 0);
    });

    document.addEventListener('theme-drawer:close', function () {
      document.removeEventListener('click', lcOutside);
      document.removeEventListener('keydown', lcEsc);
    });
  }

  }


  var form = document.getElementById("lc-form-" + S);
  var cta = document.getElementById("lc-cta-" + S);
  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var vid = form.querySelector("[name=id]").value;
      var qty = form.querySelector("[name=quantity]").value;
      window.lcCartAdd(vid, qty, cta);
    });
  }

})();
</script>

