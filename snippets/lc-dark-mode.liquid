{%- comment -%}
  LC - Dark mode.
  Temanin butun rengleri :root deyisenlerinden gelir (color-palette.liquid),
  ona gore qaranliq rejim ucun hemin deyisenlerin ustunden yazmaq kifayetdir -
  Horizonun oz komponentleri avtomatik uygunlasir.
  lc-* bolmelerinin rengleri ise bolme ayarlarindan geldiyi ucun ayrica elave olunur.
  Ayar "Light" olanda bu fayl hec ne cixarmir - sayt tam oz halinda qalir.
{%- endcomment -%}

{%- if settings.lc_color_mode == 'dark' -%}
  {%- liquid
    assign d_bg = settings.lc_dark_bg | default: '#0B1120'
    assign d_surface = settings.lc_dark_surface | default: '#121A2E'
    assign d_ink = settings.lc_dark_ink | default: '#E8EEFB'
    assign d_muted = settings.lc_dark_muted | default: '#9DAFCE'
    assign d_line = settings.lc_dark_line | default: '#27324C'
  -%}
  <style data-lc-dark>
    :root {
      --color-background: {{ d_bg }};
      --color-background-rgb: {{ d_bg.rgb }};
      --color-foreground: {{ d_ink }};
      --color-foreground-rgb: {{ d_ink.rgb }};
      --color-border: {{ d_line }};
      --color-border-rgb: {{ d_line.rgb }};

      --color-input-background: {{ d_surface }};
      --color-input-text: {{ d_ink }};
      --color-input-text-rgb: {{ d_ink.rgb }};
      --color-input-border: {{ d_line }};

      --color-variant-background: {{ d_surface }};
      --color-variant-text: {{ d_ink }};
      --color-variant-text-rgb: {{ d_ink.rgb }};
      --color-variant-border: {{ d_line }};

      --color-foreground-muted: rgb({{ d_ink.rgb }} / 0.74);
      --color-foreground-subdued: rgb({{ d_ink.rgb }} / 0.56);
    }

    html,
    body {
      background-color: {{ d_bg }};
      color: {{ d_ink }};
    }

    /* Horizonun bolme arxa fonu ayrica qatda cekilir */
    .shopify-section:not(.header-section) .section-background {
      background-color: {{ d_bg }} !important;
    }

    /* LC palitrasi - hamisi bir yerden */
    :root {
      --lc-bg: {{ d_bg }} !important;
      --lc-surface: {{ d_surface }} !important;
      --lc-card: {{ d_surface }} !important;
      --lc-ink: {{ d_ink }} !important;
      --lc-ink-rgb: {{ d_ink.rgb }} !important;
      --lc-blue: {{ d_ink }} !important;
      --lc-muted: {{ d_muted }} !important;
      --lc-line: {{ d_line }} !important;
    }

    section[id^="lc-"] {
      background: var(--lc-sec-bg, {{ d_bg }}) !important;
    }

    /* Zolaq uslubu: fonu --lc-ink-den alirdi, indi o aciqdir - ayrica verilir */
    [id^="lc-steps-"].strip .grid {
      background: {{ d_surface }} !important;
      border: 1px solid {{ d_line }};
    }

    /* Sebet paneli ve diger acilan panellər.
       Onlarin rengi bolme seviyyesinde (.color-custom-...) teyin olunur ve
       :root-dan sonra yuklenir, ona gore burada acig-askar ustunden yazilir. */
    dialog,
    theme-drawer,
    theme-drawer dialog,
    cart-drawer-component,
    #cart-drawer,
    #cart-drawer [class*="color-custom-"],
    dialog [class*="color-custom-"] {
      --color-background: {{ d_bg }} !important;
      --color-background-rgb: {{ d_bg.rgb }} !important;
      --color-foreground: {{ d_ink }} !important;
      --color-foreground-rgb: {{ d_ink.rgb }} !important;
      --color-border: {{ d_line }} !important;
      --color-border-rgb: {{ d_line.rgb }} !important;
      --color-foreground-muted: rgb({{ d_ink.rgb }} / 0.74) !important;
      --color-foreground-subdued: rgb({{ d_ink.rgb }} / 0.56) !important;
    }

    dialog {
      background-color: {{ d_bg }} !important;
      color: {{ d_ink }} !important;
    }

    #cart-drawer .cart-item,
    #cart-drawer .cart-items__inner,
    dialog .card {
      background-color: {{ d_surface }} !important;
      border-color: {{ d_line }} !important;
    }

    /* Sebetdeki "pulsuz catdirilma" zolagi - yazilari tund yasil idi */
    .lc-cartnote__text b {
      color: #D7F7C4 !important;
    }

    .lc-cartnote__text i {
      color: rgb(215 247 196 / 0.72) !important;
    }

    .lc-cartnote {
      background: linear-gradient(90deg, rgb(23 66 162 / 0.22) 0%, rgb(111 208 74 / 0.26) 100%) !important;
    }

    .lc-cartnote__bar {
      background: rgb(255 255 255 / 0.14) !important;
    }

    .lc-cartnote::after {
      background: linear-gradient(100deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.22), rgb(255 255 255 / 0)) !important;
    }

    /* Bolmelerde birbasa ag verilmis yerler */
    [id^="lc-hero-"] .lc-opt,
    [id^="lc-hero-"] .lc-colors button.on,
    [id^="lc-faq-"] details {
      background: {{ d_surface }} !important;
    }

    [id^="lc-hero-"] .lc-opt {
      border-color: {{ d_line }} !important;
    }

    /* Kart ve serhedler */
    [id^="lc-"] .st,
    [id^="lc-"] .lc-rev__card,
    [id^="lc-"] .card {
      border-color: {{ d_line }} !important;
    }
  </style>
{%- endif -%}
