{%- comment -%}
  LC Starter - butun saytin reng palitrasi.
  Rengler bir yerden idare olunur: Theme settings -> Colors.
  Bolmelerde ayri-ayri reng secicileri yoxdur; her bolmede yalniz
  "fon: acig / calarli" secimi var. Belelikle eyni rengi iki yerden
  deyismek ehtiyaci aradan qalxir.
{%- endcomment -%}
<style>
  :root {
    --lc-bg: {{ settings.lcx_bg | default: '#FFFFFF' }};
    --lc-surface: {{ settings.lcx_surface | default: '#F3F7FF' }};
    --lc-blue: {{ settings.lcx_heading | default: '#10204A' }};
    --lc-ink: {{ settings.lcx_text | default: '#10204A' }};
    --lc-muted: {{ settings.lcx_muted | default: '#5B6B8C' }};
    --lc-accent: {{ settings.lcx_button | default: '#BFFF0F' }};
    --lc-accent-ink: {{ settings.lcx_button_text | default: '#0B1429' }};
    --lc-line: {{ settings.lcx_line | default: '#DDE6F5' }};
    --lc-star: {{ settings.lcx_star | default: '#FFC107' }};
    --lc-card: var(--lc-surface);

    /* elan zolagi */
    --lc-ann-a: {{ settings.lcx_ann_start | default: '#1742A2' }};
    --lc-ann-b: {{ settings.lcx_ann_end | default: '#9FE870' }};

    /* sebet zolagi ve konfeti bu palitradan torenir */
    --lc-ann-a-rgb: {{ settings.lcx_ann_start.rgb | default: '23 66 162' }};
    --lc-ann-b-rgb: {{ settings.lcx_ann_end.rgb | default: '159 232 112' }};
    --lc-ink-rgb: {{ settings.lcx_text.rgb | default: '16 32 74' }};
  }

  /* Basliqlar her yerde eyni rengdedir */
  [id^="lc-"] h1,
  [id^="lc-"] h2,
  [id^="lc-"] h3 { color: var(--lc-blue); }
</style>
